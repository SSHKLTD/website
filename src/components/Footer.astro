---
import { site } from '../data/site.js';
const year = new Date().getFullYear();
const nav = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/works', label: 'Works' },
  { href: '/clients', label: 'Clients' },
  { href: '/careers', label: 'Careers' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="cols">
      <div class="brand-col">
        <img src="/brand/sshk-logo-white.png" alt="SSHK — Social Strategy Hong Kong" width="150" height="63" loading="lazy" />
        <p class="muted tagline-line">The next chapter is written by you — not about you.</p>
      </div>
      <nav aria-label="Footer">
        <ul class="foot-nav">
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <address>
        <a href={site.mapsUrl} rel="noopener" target="_blank">{site.address}</a>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <div class="socials">
          <a href={site.facebook} rel="noopener" target="_blank">Facebook</a>
          <a href={site.linkedin} rel="noopener" target="_blank">LinkedIn</a>
        </div>
      </address>
    </div>
    <p class="legal muted">© {year} {site.legalName} All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(3rem, 6vw, 4.5rem) 2rem; border-top: var(--bw) solid var(--ink); }
  .cols { display: grid; gap: 2.5rem; grid-template-columns: 1fr; padding-bottom: 2.5rem; border-bottom: 1px solid var(--line-dark); }
  @media (min-width: 760px) { .cols { grid-template-columns: 1.4fr 1fr 1.4fr; } }
  .brand-col img { width: 140px; height: auto; }
  .tagline-line { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; margin-top: 1.2rem; }
  .foot-nav { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .55rem; }
  .foot-nav a, address a { color: inherit; text-decoration: none; font-size: .92rem; font-weight: 600; }
  .foot-nav a:hover, address a:hover { color: var(--acc); }
  address { font-style: normal; display: flex; flex-direction: column; gap: .55rem; }
  .socials { display: flex; gap: 1.4rem; margin-top: .8rem; }
  .socials a { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; border-bottom: 2px solid var(--acc); padding-bottom: .15rem; }
  .legal { font-size: .8rem; margin: 1.6rem 0 0; }
</style>
