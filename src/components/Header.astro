---
const nav = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/works', label: 'Works' },
  { href: '/clients', label: 'Clients' },
  { href: '/careers', label: 'Careers' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo-link" aria-label="Social Strategy Hong Kong — home">
      <img src="/brand/sshk-logo-black.png" alt="SSHK — Social Strategy Hong Kong" width="132" height="56" loading="eager" />
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href || path.startsWith(item.href + '/') ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper);
    border-bottom: var(--bw) solid var(--ink);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: .8rem; }
  .logo-link img { width: 112px; height: auto; }

  .site-nav ul { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; align-items: center; }
  .site-nav a {
    font-weight: 800; font-size: .8rem;
    letter-spacing: .1em; text-transform: uppercase; text-decoration: none;
    padding: .7em 1em;
    transition: background var(--snap), color var(--snap);
  }
  .site-nav a:hover { background: var(--ink); color: var(--acc); }
  .site-nav a[aria-current='page'] { background: var(--acc); color: var(--ink); }

  .menu-btn { display: none; background: var(--acc); border: var(--bw) solid var(--ink); padding: .7rem .75rem; cursor: pointer; box-shadow: 3px 3px 0 var(--ink); }
  .bars, .bars::before, .bars::after {
    content: ''; display: block; width: 1.15rem; height: 2px; background: var(--ink); transition: transform .18s ease;
  }
  .bars { position: relative; }
  .bars::before { position: absolute; top: -6px; }
  .bars::after { position: absolute; top: 6px; }

  @media (max-width: 860px) {
    .menu-btn { display: block; }
    .site-nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: var(--bw) solid var(--ink); }
    .site-nav.open { display: block; }
    .site-nav ul { flex-direction: column; gap: 0; padding: .5rem var(--pad) 1rem; align-items: stretch; }
    .site-nav a { display: block; padding: .9rem .6rem; font-size: .95rem; }
  }
</style>

<script>
  const btn = document.querySelector('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
