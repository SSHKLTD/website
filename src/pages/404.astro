---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | SSHK" description="This page could not be found.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="display">This page has<br />gone quiet</h1>
      <p class="lede" style="margin-top:1.5rem;">
        The page you are looking for does not exist — or has moved during our redesign.
      </p>
      <div style="margin-top:2.2rem;display:flex;gap:1rem;flex-wrap:wrap;">
        <a class="btn solid" href="/">Back to home</a>
        <a class="btn" href="/works">Browse works</a>
      </div>
    </div>
  </section>
</Base>
