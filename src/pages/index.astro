    .stream .post.read .rstamp { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) and (max-width: 1359px) {
    .stream .post.rl { display: none; }
  }
  @media (prefers-reduced-motion: reduce) and (max-width: 900px) {
    .stream .post { display: none !important; }
  }

  /* ---------- chapter markers ---------- */
  .chapter { padding-block: clamp(1rem, 2vw, 1.75rem) 0; }
  .ch-line { display: flex; align-items: center; gap: 1.2rem; }
  .ch-line::before, .ch-line::after { content: ''; flex: 1; border-top: 1px solid var(--line); }
  .ch-label { font: 600 10px/1 var(--font-mono); letter-spacing: .14em; color: var(--grey-2); white-space: nowrap; }

  /* ---------- triage: read → score → flag → respond ---------- */
  .triage { --pos: #1E9455; --neg: #D6453D; }
  .t-stick { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .triage.scrub .t-track { height: 320vh; }
  .triage.scrub .t-stick {
    position: sticky; top: 72px; height: calc(100svh - 72px);
    display: flex; align-items: center; padding-block: 0; overflow: clip;
  }

  .t-grid { display: grid; grid-template-columns: minmax(300px, 380px) 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; width: 100%; }
  .t-rail .h2 { margin-top: .6rem; }
  .t-steps { list-style: none; margin: 1.9rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1.15rem; }
  .t-steps li { display: flex; align-items: flex-start; gap: .9rem; transition: opacity .45s ease; }
  .t-num {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 30px; height: 19px; padding: 0 6px; margin-top: .1rem;
    border-radius: 999px; background: var(--card); border: 1px solid var(--line);
    font: 600 9.5px/1 var(--font-mono); color: var(--grey); letter-spacing: .08em;
    transition: background .35s ease, color .35s ease, border-color .35s ease;
  }
  .t-steps h3 { font-size: .95rem; font-weight: 700; margin: 0 0 .25rem; }
