    @keyframes grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    .go .rise { animation: draw 1s ease-out .5s both; }
    .go .rise-dot { animation: fadein .4s ease 1.4s both, pulse-dot 2.2s ease-in-out 1.8s infinite; }
    @keyframes pulse-dot {
