---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import works from '../data/works.json';
import clientGroups from '../data/clients.json';
import { coverOf } from '../lib/content.js';

const featured = works.filter((w) => w.featured).slice(0, 3);
const logoStrip = ['mtr', 'cathay-pacific', 'standard-chartered', 'hkjc', 'alibaba', 'unicef', 'hku', 'tesla', 'hang-seng', 'foodpanda', 'hktb', 'samsung'];
const logoNames = Object.fromEntries(
  clientGroups.flatMap((g) => g.clients.map((c) => [c.slug, c.name]))
);

const pillars = [
  {
    n: '01',
    k: 'LISTEN',
    title: 'Social Listening',
    href: '/services/social-listening',
    desc: 'AI-powered monitoring with 24/7 human judgement. Negative signals are caught while they are still whispers — not tomorrow’s headlines.',
  },
  {
    n: '02',
    k: 'MANAGE',
    title: 'Issue & Crisis Management',
    href: '/services/issue-management',
    desc: 'The first 48 hours decide everything. Risk grading, response strategy and around-the-clock crisis support, built on a newsroom instinct.',
  },
  {
    n: '03',
    k: 'CREATE',
    title: 'Campaign & Production',
    href: '/services/campaign-production',
    desc: 'Concepts, social retainers, photography and video — brand stories told in the language of the internet, produced fully in-house.',
  },
];

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.shortName,
  url: site.url,
  logo: `${site.url}/brand/sshk-logo-black.png`,
  email: site.email,
  telephone: site.phone,
  foundingDate: String(site.foundedYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6/F, China Paint Building, No. 1163 Canton Road',
    addressLocality: 'Mong Kok',
    addressRegion: 'Kowloon',
    addressCountry: 'HK',
  },
  sameAs: [site.facebook, site.linkedin],
});
---

<Base title="Social Strategy Hong Kong | Crisis Management Expert">
  <script slot="head" type="application/ld+json" set:html={orgLd} />

  <section class="hero">
    <video autoplay muted loop playsinline preload="metadata" poster="/images/hero-poster.webp" aria-hidden="true">
      <source src="/hero.mp4" type="video/mp4" />
    </video>
    <div class="scrim"></div>
    <div class="wrap hero-inner">
      <p class="hero-eyebrow">Social Strategy Hong Kong</p>
      <h1 class="display">Crisis Management<br />Expert</h1>
      <p class="lede">
        An integrated creative communication agency with deep market roots and a strong digital DNA.
        We listen. We manage. We create.
      </p>
      <div class="hero-cta">
        <a class="btn solid" href="/contact">Talk to us</a>
        <a class="btn" href="/works">See our work</a>
      </div>
    </div>
  </section>

  <div class="stats" role="list" aria-label="SSHK at a glance">
    <div class="stat" role="listitem"><div class="v">2010</div><div class="k">Roots since Photoblog.hk</div></div>
    <div class="stat" role="listitem"><div class="v">50+</div><div class="k">Professionals</div></div>
    <div class="stat" role="listitem"><div class="v">24/7</div><div class="k">Crisis monitoring &amp; alert</div></div>
    <div class="stat" role="listitem"><div class="v">55+</div><div class="k">Leading organisations served</div></div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 class="h2">We listen. We manage.<br />We create.</h2>
        </div>
        <a class="arrow-link" href="/services">All services →</a>
      </div>
      <div class="grid cols-3">
        {pillars.map((p) => (
          <a class="card pillar" href={p.href}>
            <span class="num-label">{p.n} · {p.k}</span>
            <h3 class="h3">{p.title}</h3>
            <p class="muted">{p.desc}</p>
            <span class="arrow-link" aria-hidden="true">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tinted">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected works</p>
          <h2 class="h2">Stories that moved the needle</h2>
        </div>
        <a class="arrow-link" href="/works">All case studies →</a>
      </div>
      <div class="grid cols-3">
        {featured.map((w) => (
          <a class="work-card" href={`/works/${w.slug}`}>
            <span class="thumb"><img src={coverOf(w)} alt={`${w.client} — ${w.title}`} loading="lazy" width="640" height="400" /></span>
            <span class="meta">
              <span class="client">{w.client}</span>
              <span class="title">{w.title}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Trusted by</p>
          <h2 class="h2">Institutions &amp; brands</h2>
        </div>
        <a class="arrow-link" href="/clients">All clients →</a>
      </div>
      <ul class="logo-strip" aria-label="Selected clients">
        {logoStrip.map((slug) => (
          <li><img src={`/images/clients/${slug}.webp`} alt={logoNames[slug] ?? slug} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section on-dark cta-band">
    <div class="wrap">
      <p class="eyebrow">Next step</p>
      <h2 class="h2">Talk to us.<br />Problem will be solved.</h2>
      <div class="hero-cta">
        <a class="btn solid" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: min(88vh, 46rem); display: flex; align-items: flex-end; color: #f5f5f2; overflow: hidden; }
  .hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,11,12,.25) 0%, rgba(10,11,12,.72) 78%); }
  .hero-inner { position: relative; padding-block: clamp(3rem, 8vw, 5.5rem); }
  .hero-eyebrow { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .3em; text-transform: uppercase; margin: 0 0 1.2rem; color: #cfd2d4; }
  .hero .lede { margin-top: 1.4rem; color: #e4e5e3; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.2rem; }
  .hero .btn { border-color: #f5f5f2; color: #f5f5f2; }
  .hero .btn:hover { background: #f5f5f2; color: var(--ink); }
  .hero .btn.solid { background: #f5f5f2; color: var(--ink); }
  .hero .btn.solid:hover { background: var(--signal); color: #fff; border-color: var(--signal); }

  .pillar { color: inherit; text-decoration: none; }
  .pillar:hover { border-color: var(--ink); }
  .pillar .arrow-link { margin-top: auto; align-self: flex-start; border-bottom: none; }
  .pillar:hover .arrow-link { color: var(--signal); }

  .logo-strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (min-width: 720px) { .logo-strip { grid-template-columns: repeat(6, 1fr); } }
  .logo-strip li { background: var(--paper); display: flex; align-items: center; justify-content: center; padding: 1.6rem 1.4rem; min-height: 6.2rem; }
  .logo-strip img { max-height: 3rem; width: auto; max-width: 100%; filter: grayscale(1); opacity: .78; transition: filter .2s ease, opacity .2s ease; }
  .logo-strip li:hover img { filter: none; opacity: 1; }

  .cta-band .hero-cta { margin-top: 2rem; }
</style>
