  .t-steps .arrow-link { margin-top: .5rem; display: inline-block; font-size: .85rem; }
  /* NB: keep this base rule lower-specificity than the .p0–.p3 overrides —
     Astro's scope attributes count toward specificity on every compound */
  .scrub .t-steps li { opacity: .25; }
  .triage.scrub.p0 .s0 { opacity: 1; }
  .triage.scrub.p1 .s0 { opacity: .25; }
  .triage.scrub.p1 .s1 { opacity: 1; }
  .triage.scrub.p2 .s1 { opacity: .25; }
  .triage.scrub.p2 .s2 { opacity: 1; }
  .triage.scrub.p3 .s2 { opacity: .25; }
  .triage.scrub.p3 .s3 { opacity: 1; }
  .triage.scrub.p0 .s0 .t-num { background: var(--link); border-color: var(--link); color: #fff; }
  .triage.scrub.p1 .s0 .t-num { background: var(--card); border-color: var(--line); color: var(--grey); }
  .triage.scrub.p1 .s1 .t-num { background: var(--link); border-color: var(--link); color: #fff; }
  .triage.scrub.p2 .s1 .t-num { background: var(--card); border-color: var(--line); color: var(--grey); }
  .triage.scrub.p2 .s2 .t-num { background: var(--link); border-color: var(--link); color: #fff; }
  .triage.scrub.p3 .s2 .t-num { background: var(--card); border-color: var(--line); color: var(--grey); }
  .triage.scrub.p3 .s3 .t-num { background: var(--link); border-color: var(--link); color: #fff; }

  .t-stage { position: relative; height: clamp(400px, 52vh, 520px); }
  .t-count { position: absolute; right: 0; top: -28px; font: 500 10px/1 var(--font-mono); letter-spacing: .09em; color: var(--grey-2); opacity: 0; transition: opacity .4s ease; }
  .t-count b { color: var(--alert); font-weight: 600; }

  .tcard {
    position: absolute; left: var(--tx); top: var(--ty); width: clamp(190px, 30%, 240px);
    background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--line); border-radius: 14px;
    padding: 11px 13px 10px; box-shadow: 0 10px 26px rgba(22, 24, 27, 0.07);
    transform: rotate(var(--tr));
    transition: opacity .5s ease, transform .5s ease, border-color .5s ease, box-shadow .5s ease, filter .5s ease;
  }
  .tcard header { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 5px; font: 500 10.5px/1 var(--font-mono); }
  .tcard header .u { color: var(--link); }
  .tcard header .t { color: var(--grey-2); }
  .tcard p { font: 400 12px/1.5 var(--font-sans); color: var(--ink); margin: 0; }
  .tcard footer { margin-top: 7px; font: 400 10px/1 var(--font-mono); color: var(--grey-2); }

  .tstamp {
    position: absolute; top: -10px; right: -9px;
    font: 600 9.5px/1 var(--font-mono); letter-spacing: .05em; white-space: nowrap;
    color: var(--alert); background: var(--card); border: 1px solid var(--alert);
    border-radius: 999px; padding: 4px 8px;
    opacity: 0; transform: rotate(-4deg) scale(.5);
    transition: opacity .3s ease, transform .3s cubic-bezier(.2, 1.6, .4, 1);
    transition-delay: calc(var(--i) * 90ms);
  }
  .score {
    position: absolute; right: -8px; bottom: -10px;
    font: 600 10px/1 var(--font-mono); letter-spacing: .05em;
    background: var(--card); border: 1px solid; border-radius: 999px; padding: 4px 8px;
    opacity: 0; transform: translateY(6px);
    transition: opacity .4s ease, transform .4s ease;
    transition-delay: calc(var(--i) * 70ms);
  }
  .tcard.pos .score { color: var(--pos); border-color: var(--pos); }
  .tcard.neg .score { color: var(--neg); border-color: var(--neg); }
  .tflag {
    position: absolute; top: -10px; left: 10px;
    font: 600 9.5px/1 var(--font-mono); letter-spacing: .06em; white-space: nowrap;
    color: #fff; background: var(--alert); border-radius: 999px; padding: 4px 8px;
    opacity: 0; transform: scale(.6) rotate(-3deg);
    transition: opacity .35s ease, transform .35s cubic-bezier(.2, 1.5, .4, 1), background-color .4s ease;
    transition-delay: calc((var(--i) - 3) * 80ms);
  }
  .thandle {
    display: block; margin-top: 0; padding-top: 0; border-top: 1px dashed transparent;
    font: 600 9.5px/1.4 var(--font-mono); letter-spacing: .07em; color: var(--link); white-space: nowrap;
    opacity: 0; max-height: 0; overflow: hidden;
    transition: opacity .45s ease, max-height .45s ease, margin-top .45s ease, padding-top .45s ease, border-color .45s ease;
    transition-delay: calc((var(--i) - 3) * 90ms + 80ms);
  }

  .triage.p0 .tstamp { opacity: 1; transform: rotate(-4deg) scale(1); }
  .triage.p1 .score { opacity: 1; transform: none; }
  .triage.p1 .tcard.pos { border-left-color: var(--pos); }
  .triage.p1 .tcard.neg { border-left-color: var(--neg); }
  .triage.p2 .tcard.pos { opacity: .35; filter: grayscale(1); transform: rotate(var(--tr)) scale(.96); }
  .triage.p2 .tcard.neg { transform: rotate(0deg) scale(1.04); box-shadow: 0 18px 44px rgba(22, 24, 27, 0.13); }
  .triage.p2 .tflag { opacity: 1; transform: none; }
  .triage.p2 .t-count { opacity: 1; }
  .triage.p3 .tcard.neg { border-color: var(--link); border-left-color: var(--link); box-shadow: 0 12px 30px rgba(36, 105, 212, 0.14); }
  .triage.p3 .tflag { background: var(--link); }
  .triage.p3 .thandle { opacity: 1; max-height: 24px; margin-top: 9px; padding-top: 8px; border-top-color: var(--line); }

  /* no JS / reduced motion: everything in its worked, final state */
  .triage:not(.scrub) .tstamp { opacity: 1; transform: rotate(-4deg) scale(1); }
  .triage:not(.scrub) .score { opacity: 1; transform: none; }
  .triage:not(.scrub) .tcard.pos { border-left-color: var(--pos); }
  .triage:not(.scrub) .tcard.neg { border-left-color: var(--neg); border-color: var(--link); border-left-color: var(--link); }
  .triage:not(.scrub) .tflag { opacity: 1; transform: none; background: var(--link); }
  .triage:not(.scrub) .thandle { opacity: 1; max-height: 24px; margin-top: 9px; padding-top: 8px; border-top-color: var(--line); }
  .triage:not(.scrub) .t-count { opacity: 1; }

  @media (max-width: 860px) {
    .t-grid { grid-template-columns: 1fr; gap: 1.4rem; align-items: start; }
    .t-rail .h2 { font-size: 1.45rem; }
    .triage.scrub .t-stick { align-items: flex-start; padding-top: 1.1rem; }
    .triage.scrub .t-steps { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem .9rem; margin-top: 1.1rem; }
    .triage.scrub .t-steps p, .triage.scrub .t-steps .arrow-link { display: none; }
    .t-stage { height: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .t-count { position: static; grid-column: 1 / -1; text-align: right; }
    .tcard { position: static; width: auto; }
    /* narrow cards: the flag replaces the read stamp instead of colliding with it */
    .triage.p2 .tcard.neg .tstamp, .triage:not(.scrub) .tcard.neg .tstamp { opacity: 0; }
  }

  /* ---------- creative lantern 走馬燈 ---------- */
  .creative .section-head { margin-bottom: clamp(1.6rem, 3vw, 2.4rem); }
  .lantern { display: flex; flex-direction: column; gap: 14px; overflow: hidden; }
  .m-row { display: flex; gap: 14px; width: max-content; }
  .m-set { display: flex; gap: 14px; }
  .m-item {
    position: relative; flex: 0 0 auto; width: clamp(240px, 24vw, 320px); aspect-ratio: 8 / 5;
    border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: var(--paper);
  }
  .m-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .m-cap {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 12px 9px;
    font: 600 10px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: #fff;
    background: linear-gradient(180deg, transparent, rgba(22, 24, 27, 0.62));
  }
  @media (prefers-reduced-motion: no-preference) {
    .m-left { animation: m-scroll 70s linear infinite; }
    .m-right { animation: m-scroll 84s linear infinite reverse; }
    .m-row:hover { animation-play-state: paused; }
    .m-row:focus-within { animation-play-state: paused; }
  }
  @keyframes m-scroll { to { transform: translateX(calc(-50% - 7px)); } }
  @media (prefers-reduced-motion: reduce) {
    .lantern { overflow-x: auto; }
    .m-set[aria-hidden='true'] { display: none; }
  }
</style>

<script>
  // Playbook scenes: fire each card's entrance animation once when scrolled into view
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('go'); io.unobserve(e.target); }
      });
    }, { threshold: 0.35 });
    document.querySelectorAll('.process li').forEach((li) => io.observe(li));
  }

  // Triage band: scroll position drives the pipeline phase (read → score → flag → respond)
  const triage = document.querySelector('.triage');
  if (triage && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    triage.classList.add('scrub');
    const track = triage.querySelector('.t-track');
    if (track) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = track.getBoundingClientRect();
        const vh = window.innerHeight;
        const total = rect.height - vh;
        const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
        const inView = rect.top < vh && rect.bottom > 0;
        triage.classList.toggle('p0', inView || p > 0);
        triage.classList.toggle('p1', p >= 0.3);
        triage.classList.toggle('p2', p >= 0.55);
        triage.classList.toggle('p3', p >= 0.8);
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
