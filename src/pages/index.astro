    @keyframes flamein { from { opacity: 0; transform: scale(.4); } to { opacity: 1; transform: scale(1); } }
    @keyframes flicker {
      0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
      35% { transform: scale(.9) rotate(-2deg); opacity: .85; }
      70% { transform: scale(1.06) rotate(1.5deg); opacity: .95; }
