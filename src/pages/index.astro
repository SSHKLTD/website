---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import works from '../data/works.json';
import clientGroups from '../data/clients.json';
import { coverOf } from '../lib/content.js';

const featured = works.filter((w) => w.featured).slice(0, 3);
const logoStrip = ['mtr', 'cathay-pacific', 'standard-chartered', 'hkjc', 'alibaba', 'unicef', 'hku', 'tesla', 'hang-seng', 'foodpanda', 'hktb', 'samsung'];
const logoNames = Object.fromEntries(
  clientGroups.flatMap((g) => g.clients.map((c) => [c.slug, c.name]))
);

const tickerItems = ['Social Listening', '24/7 Monitoring', 'Issue Management', 'Crisis Response', 'Campaign', 'Production', 'Social Retainers', 'KOL & Media'];

const pillars = [
  {
    n: '01',
    key: 'Listen',
    title: 'Social Listening',
    href: '/services/social-listening',
    desc: 'Every crisis is a whisper before it is a headline. Our desk reads Hong Kong the way an editor reads the wires — around the clock, across every platform, in both languages the city argues in — so you hear the murmur while it is still a murmur.',
  },
  {
    n: '02',
    key: 'Manage',
    title: 'Issue & Crisis Management',
    href: '/services/issue-management',
    desc: 'When the story turns, the worst place to draft your reply is the middle of the storm. We have sat on the other side of the press release — so we write the statement, brief the room, and steady the narrative while it can still be steadied.',
  },
  {
    n: '03',
    key: 'Create',
    title: 'Campaign & Production',
    href: '/services/campaign-production',
    desc: 'The best defence is a story worth telling. From key visual to final cut, our studio makes work people share because they want to — campaigns with a beginning, a middle, and a reason to care.',
  },
];

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.shortName,
  url: site.url,
  logo: `${site.url}/brand/sshk-logo-black.png`,
  email: site.email,
  telephone: site.phone,
  foundingDate: String(site.foundedYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6/F, China Paint Building, No. 1163 Canton Road',
    addressLocality: 'Mong Kok',
    addressRegion: 'Kowloon',
    addressCountry: 'HK',
  },
  sameAs: [site.facebook, site.linkedin],
});
---

<Base title="Social Strategy Hong Kong | Crisis Management Expert">
  <script slot="head" type="application/ld+json" set:html={orgLd} />

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Social Strategy Hong Kong · Crisis Management Expert</p>
      <h1 class="display hero-h1">
        Every brand is one headline away from <span class="hl">becoming the story.</span>
      </h1>
      <div class="hero-deck">
        <p class="hero-sub">
          We are the newsroom on your side of it — fifty storytellers and former journalists, reading
          Hong Kong around the clock, so the next chapter is written by you, not about you.
        </p>
        <div class="hero-stamps" aria-hidden="true">
          <span class="stamp tilt-l">Est. 2010</span>
          <span class="stamp blue tilt-r">Mong Kok, HK</span>
          <span class="stamp tilt-l">First read &lt; 2 hrs</span>
        </div>
      </div>
      <div class="hero-cta">
        <a class="btn solid" href="/contact">Brief the desk</a>
        <a class="btn" href="/works">Read our stories</a>
      </div>
    </div>
    <div class="hero-media wrap">
      <img src="/images/studio.webp" alt="The SSHK team on the rooftop of China Paint Building, Mong Kok" width="1600" height="686" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => tickerItems.map((t) => <span>{t} <i>✦</i></span>))}
    </div>
  </div>

  <div class="stats" role="list" aria-label="SSHK at a glance">
    <div class="stat" role="listitem"><div class="v">2010</div><div class="k">Roots in Photoblog.hk — 400K readers before we ever wrote a post for a client</div></div>
    <div class="stat" role="listitem"><div class="v">50+</div><div class="k">Storytellers, producers &amp; former journalists</div></div>
    <div class="stat" role="listitem"><div class="v">24/7</div><div class="k">The desk never closes — day, night, typhoon signal eight</div></div>
    <div class="stat" role="listitem"><div class="v">55+</div><div class="k">Leading organisations trust us with their story</div></div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 class="h2">Three chapters.<br /><span class="hl">One discipline.</span></h2>
        </div>
        <a class="arrow-link" href="/services">All services →</a>
      </div>
      <div class="pillars">
        {pillars.map((p) => (
          <a class="pillar" href={p.href}>
            <span class="pillar-num" aria-hidden="true">{p.n}</span>
            <span class="pillar-key">{p.key}</span>
            <h3 class="pillar-title">{p.title}</h3>
            <p>{p.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tinted">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected works</p>
          <h2 class="h2">Work worth<br />the <span class="hl">front page.</span></h2>
        </div>
        <a class="arrow-link" href="/works">All case studies →</a>
      </div>
      <div class="grid cols-3">
        {featured.map((w) => (
          <a class="work-card" href={`/works/${w.slug}`}>
            <span class="thumb"><img src={coverOf(w)} alt={`${w.client} — ${w.title}`} loading="lazy" width="640" height="400" /></span>
            <span class="meta">
              <span class="client">{w.client}</span>
              <span class="title">{w.title}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="marquee ink" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => ['MTR', 'Cathay Pacific', 'HKIA', 'Standard Chartered', 'HKJC', 'Alibaba', 'UNICEF', 'Tesla'].map((t) => <span>{t} <i>✦</i></span>))}
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The company we keep</p>
          <h2 class="h2">Trusted by the ones who<br /><span class="hl">can't afford a bad day.</span></h2>
        </div>
        <a class="arrow-link" href="/clients">All clients →</a>
      </div>
      <ul class="logo-strip" aria-label="Selected clients">
        {logoStrip.map((slug) => (
          <li><img src={`/images/clients/${slug}.webp`} alt={logoNames[slug] ?? slug} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section on-blue cta-band">
    <div class="wrap">
      <h2 class="display cta-h">The next chapter is unwritten. Let's decide who holds the pen.</h2>
      <div class="cta-row">
        <p class="cta-sub">
          Whether the story is turning against you or simply waiting to be told — tell us where it
          stands. The desk reads every brief within two hours.
        </p>
        <a class="btn solid" href="/contact">Brief the desk</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(2.5rem, 5vw, 4.5rem); }
  .hero-h1 { max-width: 18ch; margin-bottom: clamp(1.8rem, 3vw, 3rem); }
  .hero-deck { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2rem, 3vw, 3rem); }
  .hero-sub {
    max-width: 52ch; font-size: clamp(1.05rem, 1.5vw, 1.3rem); font-weight: 500; line-height: 1.5;
    border-left: 6px solid var(--acc); padding-left: 1em; margin: 0;
  }
  .hero-stamps { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-bottom: clamp(2.5rem, 4vw, 4rem); }
  .hero-media img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border: var(--frame); background: var(--ink); }

  .pillars { display: grid; grid-template-columns: 1fr; border: var(--bw) solid var(--ink); }
  @media (min-width: 860px) { .pillars { grid-template-columns: repeat(3, 1fr); } }
  .pillar {
    position: relative; border-bottom: var(--bw) solid var(--ink);
    padding: clamp(1.5rem, 2.6vw, 2.75rem);
    display: flex; flex-direction: column; text-decoration: none;
    min-height: clamp(20rem, 30vw, 30rem);
    transition: background var(--snap), color var(--snap);
  }
  .pillar:last-child { border-bottom: none; }
  @media (min-width: 860px) {
    .pillar { border-bottom: none; border-right: var(--bw) solid var(--ink); }
    .pillar:last-child { border-right: none; }
  }
  .pillar-num {
    font-weight: 900; font-size: clamp(5.5rem, 9vw, 9rem); line-height: .82; letter-spacing: -.02em;
    margin-bottom: auto; transition: color var(--snap);
  }
  .pillar-key {
    align-self: flex-start;
    font-weight: 900; font-size: clamp(1.4rem, 2vw, 1.9rem); text-transform: uppercase;
    background: var(--acc); padding: .1em .3em;
    margin: clamp(1.2rem, 2vw, 2rem) 0 .5em;
  }
  .pillar-title { font-weight: 800; font-size: .95rem; text-transform: uppercase; letter-spacing: .14em; margin-bottom: .9em; }
  .pillar p { font-size: .98rem; line-height: 1.6; max-width: 36ch; margin: 0; }
  .pillar:hover { background: var(--ink); color: var(--paper); }
  .pillar:hover .pillar-num { color: var(--acc); }

  .logo-strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--bw); background: var(--ink); border: var(--bw) solid var(--ink); }
  @media (min-width: 720px) { .logo-strip { grid-template-columns: repeat(6, 1fr); } }
  .logo-strip li { background: var(--paper); display: flex; align-items: center; justify-content: center; padding: 1.6rem 1.4rem; min-height: 6.2rem; transition: background var(--snap); }
  .logo-strip img { max-height: 3rem; width: auto; max-width: 100%; filter: grayscale(1) contrast(1.05); transition: filter var(--snap); }
  .logo-strip li:hover { background: var(--acc); }
  .logo-strip li:hover img { filter: none; }

  .cta-h { max-width: 16ch; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); font-size: clamp(2.2rem, 6vw, 5rem); }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .cta-sub { font-weight: 600; font-size: clamp(1rem, 1.5vw, 1.25rem); max-width: 38ch; margin: 0; }
</style>
