<script>
  // Playbook scenes: fire each card's entrance animation once when scrolled into view
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('go'); io.unobserve(e.target); }
      });
    }, { threshold: 0.35 });
    document.querySelectorAll('.process li').forEach((li) => io.observe(li));
  }

  // Desk clock — Hong Kong time, minute precision (calm, no ticking)
  const el = document.getElementById('hkt');
  if (el) {
    let fmt: Intl.DateTimeFormat | null = null;
    try {
      fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Hong_Kong' });
    } catch { fmt = null; }
    const tick = () => { el.textContent = 'HKT ' + (fmt ? fmt.format(new Date()) : new Date().toTimeString().slice(0, 5)); };
    tick();
    setInterval(tick, 30000);
  }
</script>
