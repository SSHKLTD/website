---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import works from '../data/works.json';
import clientGroups from '../data/clients.json';
import { coverOf } from '../lib/content.js';

const featured = works.filter((w) => w.featured).slice(0, 3);
const logoStrip = ['mtr', 'cathay-pacific', 'standard-chartered', 'hkjc', 'alibaba', 'unicef', 'hku', 'tesla', 'hang-seng', 'foodpanda', 'hktb', 'samsung'];
const logoNames = Object.fromEntries(
  clientGroups.flatMap((g) => g.clients.map((c) => [c.slug, c.name]))
);

// Anonymised, invented posts for the ambient stream (decorative only).
// mk = keeps showing on mobile · rk/rl = shown in the reduced-motion static sample
const posts = [
  // right lane (sharp)
  { u: '@user432', t: '4m', p: '今次公關災難…點收科 🙈', f: '♥ 1.2k · ↻ 340', cls: 'mk rk read', vars: '--x:76%;--d:28s;--dl:-4s;--mx:52%;--sx:74%;--st:10%', s: 'READ ✓ 0.4s' },
  { u: '熱門', t: '2m', p: '機場新跑道 好正 ✈️', f: '♥ 3.8k · ↻ 1.4k', cls: 'mk rk read', vars: '--x:86%;--d:34s;--dl:-18s;--mx:8%;--sx:74%;--st:44%', s: 'READ ✓ 0.3s' },
  { u: '熱門', t: '33s', p: '兩餸飯評測 thread 🍱 越寫越長', f: '♥ 2.1k · ↻ 690', cls: '', vars: '--x:80%;--d:30s;--dl:-2s', s: 'READ ✓ 0.5s' },
  { u: '@user660', t: '9m', p: '個 campaign 條片幾好笑，已 share', f: '♥ 1.5k · ↻ 412', cls: '', vars: '--x:72%;--d:42s;--dl:-33s', s: 'READ ✓ 0.3s' },
  // left lane (sharp)
  { u: '@foodie852', t: '11m', p: '呢間新餐廳排隊兩粒鐘，值唔值?', f: '♥ 689 · ↻ 76', cls: 'mk rk read', vars: '--x:8%;--d:30s;--dl:-12s;--mx:30%;--sx:7%;--st:24%', s: 'READ ✓ 0.6s' },
  { u: '#週末好去處', t: '26m', p: '西九自由約 📷 影唔停', f: '♥ 2.6k · ↻ 3.4k', cls: 'mk rk', vars: '--x:2%;--d:26s;--dl:-22s;--mx:58%;--sx:7%;--st:62%', s: 'READ ✓ 0.4s' },
  { u: '@user2081', t: '7m', p: '個 brand 道歉聲明寫得幾好，respect', f: '♥ 954 · ↻ 218', cls: '', vars: '--x:14%;--d:38s;--dl:-8s', s: 'READ ✓ 0.2s' },
  { u: '@nightowl852', t: '18m', p: '深夜茶餐廳 recommendations please 🥚', f: '♥ 212 · ↻ 31', cls: 'mk', vars: '--x:5%;--d:36s;--dl:-27s;--mx:16%', s: 'READ ✓ 0.4s' },
  // blurred edge lanes (both sides)
  { u: '#天文台', t: '1m', p: '黃雨定紅雨? ☔ 帶遮先', f: '♥ 5.2k · ↻ 2.0k', cls: 'edge rk rl read', vars: '--x:1%;--d:46s;--dl:-6s;--sx:1%;--st:82%', s: 'READ ✓ 0.4s' },
  { u: '@user917', t: '41m', p: '客服半個鐘內覆 IG DM，加分', f: '♥ 178 · ↻ 12', cls: 'edge', vars: '--x:20%;--d:50s;--dl:-24s', s: 'READ ✓ 0.5s' },
  { u: '熱門', t: '3h', p: '渡輪夜航 加開班次', f: '♥ 820 · ↻ 145', cls: 'edge', vars: '--x:26%;--d:44s;--dl:-38s', s: 'READ ✓ 0.4s' },
  { u: '@mk_walker', t: '55m', p: '旺角新壁畫 打卡位 📍', f: '♥ 645 · ↻ 88', cls: 'edge rk rl', vars: '--x:91%;--d:46s;--dl:-15s;--sx:90%;--st:66%', s: 'READ ✓ 0.6s' },
  { u: '#跑步', t: '2h', p: '10km 初馬 有咩 tips? 🏃', f: '♥ 356 · ↻ 44', cls: 'edge', vars: '--x:64%;--d:40s;--dl:-30s', s: 'READ ✓ 0.4s' },
  { u: '@user333', t: '12m', p: '睇完個 statement，印象改觀', f: '♥ 508 · ↻ 96', cls: 'edge', vars: '--x:88%;--d:52s;--dl:-11s', s: 'READ ✓ 0.3s' },
];

const modules = [
  {
    tag: 'DESK/LISTEN',
    key: 'LISTEN',
    zh: '聆聽',
    svc: 'Social Listening',
    href: '/services/social-listening',
    body: 'Every crisis is a whisper before it is a headline. Our desk reads Hong Kong the way an editor reads the wires — around the clock, across every platform, in both languages the city argues in — so you hear the murmur while it is still a murmur.',
    meta: 'coverage: <b>24/7</b> · languages: <b>2</b> · first read: <b>&lt; 2 hrs</b>',
  },
  {
    tag: 'DESK/MANAGE',
    key: 'MANAGE',
    zh: '應變',
    svc: 'Issue & Crisis Management',
    href: '/services/issue-management',
    body: 'When the story turns, the worst place to draft your reply is the middle of the storm. We have sat on the other side of the press release — so we write the statement, brief the room, and steady the narrative while it can still be steadied.',
    meta: 'first read: <b>&lt; 2 hrs</b> · escalation: <b>one call</b> · debrief: <b>full report</b>',
  },
  {
    tag: 'DESK/CREATE',
    key: 'CREATE',
    zh: '創作',
    svc: 'Campaign & Production',
    href: '/services/campaign-production',
    body: 'The best defence is a story worth telling. From key visual to final cut, our studio makes work people share because they want to — campaigns with a beginning, a middle, and a reason to care.',
    meta: 'studio: <b>in-house</b> · format: <b>KV → final cut</b> · since: <b>2010</b>',
  },
];

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.shortName,
  url: site.url,
  logo: `${site.url}/brand/sshk-logo-black.png`,
  email: site.email,
  telephone: site.phone,
  foundingDate: String(site.foundedYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6/F, China Paint Building, No. 1163 Canton Road',
    addressLocality: 'Mong Kok',
    addressRegion: 'Kowloon',
    addressCountry: 'HK',
  },
  sameAs: [site.facebook, site.linkedin],
});
---

<Base title="Social Strategy Hong Kong | Crisis Management Expert">
  <script slot="head" type="application/ld+json" set:html={orgLd} />

  <section class="hero">
    <div class="stream" aria-hidden="true">
      {posts.map((post) => (
        <article class={`post ${post.cls}`} style={post.vars}>
          <header><span class="u">{post.u}</span><span class="t">{post.t}</span></header>
          <p>{post.p}</p>
          <footer>{post.f}</footer>
          <span class="rstamp">{post.s}</span>
        </article>
      ))}
    </div>

    <div class="veil" aria-hidden="true"></div>

    <div class="deskline" aria-hidden="true">
      <div class="rule"></div>
      <span class="dtag"><span class="live-dot"></span>THE DESK · READING 24/7 · <span id="hkt">HKT --:--</span></span>
    </div>

    <div class="wrap">
      <div class="hero-panel">
        <p class="hero-kicker">Social Strategy Hong Kong · Crisis Management Expert · 危機管理</p>
        <h1 class="display">Every brand is one headline away from becoming the story.</h1>
        <p class="hero-sub">
          We are the newsroom on your side of it — fifty storytellers and former journalists, reading
          Hong Kong around the clock, so the next chapter is written by you, not about you.
        </p>
        <div class="hero-actions">
          <a class="btn solid" href="/contact">Brief the desk</a>
          <a class="btn" href="/works">Read our stories</a>
        </div>
        <p class="hero-note">MONG KOK DESK · UTC+8 · EVERY BRIEF READ WITHIN 2H</p>
      </div>
    </div>
  </section>

  <section class="stats-wrap" aria-label="Monitoring summary">
    <div class="wrap">
      <div class="stats-panel">
        <div class="stats-head">
          <span><span class="k">MONITORING SUMMARY</span> · MONG KOK DESK</span>
          <span>SHIFT: ALWAYS · LOG CONTINUOUS SINCE 2010</span>
        </div>
        <div class="stats-grid">
          <div class="stat-cell"><span class="key">since</span><p class="num">2010</p><p class="lbl">roots in Photoblog.hk</p></div>
          <div class="stat-cell"><span class="key">headcount</span><p class="num">50+</p><p class="lbl">storytellers, producers &amp; former journalists</p></div>
          <div class="stat-cell"><span class="key">coverage</span><p class="num">24/7</p><p class="lbl">the desk never closes</p></div>
          <div class="stat-cell"><span class="key">reading for</span><p class="num">55+</p><p class="lbl">leading organisations</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Services · the desk, three ways</span>
          <h2 class="h2">One desk. Three shifts of work.</h2>
        </div>
        <a class="arrow-link" href="/services">All services →</a>
      </div>
      <div class="grid cols-3">
        {modules.map((m) => (
          <a class="module" href={m.href}>
            <p class="module-tag">{m.tag}</p>
            <h3>{m.key} <span class="zh" lang="zh-Hant">{m.zh}</span></h3>
            <p class="svc">{m.svc}</p>
            <p class="mbody">{m.body}</p>
            <p class="meta-row" set:html={m.meta} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tinted" id="playbook">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">The playbook · 由觀天到救火</span>
          <h2 class="h2">From forecast to fire-out</h2>
        </div>
        <a class="arrow-link" href="/services/issue-management">The full crisis cycle →</a>
      </div>
      <p class="lede" style="margin-bottom:2.5rem;">
        Hong Kong reads weather signals; we read sentiment the same way. Every crisis follows a
        cycle — and at every stage of it, there is a right move.
      </p>
      <ol class="process">
        <li>
          <div class="scene" aria-hidden="true">
            <svg viewBox="0 0 220 96" class="scene-svg">
              <circle cx="110" cy="50" r="14" fill="none" stroke="#C9D4DE" stroke-width="1" />
              <circle cx="110" cy="50" r="28" fill="none" stroke="#C9D4DE" stroke-width="1" />
              <circle cx="110" cy="50" r="42" fill="none" stroke="#C9D4DE" stroke-width="1" />
              <line class="sweep" x1="110" y1="50" x2="152" y2="50" stroke="var(--link)" stroke-width="2" stroke-linecap="round" />
              <circle cx="110" cy="50" r="2.5" fill="var(--ink)" />
              <circle class="blip b1" cx="134" cy="32" r="3.5" fill="var(--link)" />
              <circle class="blip b2" cx="86" cy="64" r="3.5" fill="var(--alert)" />
            </svg>
          </div>
          <span class="p-tag">01 · 觀天 FORECAST</span>
          <h3 class="p-title">Watch the sky</h3>
          <p>AI monitoring across 1M+ channels, five-minute crawl intervals, trend prediction — the whisper is caught while it is still a whisper.</p>
        </li>
        <li>
          <div class="scene" aria-hidden="true">
            <svg viewBox="0 0 220 96" class="scene-svg">
              <line x1="86" y1="10" x2="86" y2="86" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" />
              <line x1="86" y1="12" x2="112" y2="12" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" />
              <line x1="112" y1="12" x2="112" y2="22" stroke="#C9D4DE" stroke-width="1.5" />
              <polygon class="t8" points="112,22 128,50 96,50" fill="var(--ink)" />
              <text class="t8-tag" x="140" y="46" font-family="IBM Plex Mono, monospace" font-size="11" fill="var(--alert)" font-weight="600">T·8</text>
              <line x1="60" y1="86" x2="160" y2="86" stroke="#C9D4DE" stroke-width="1.5" />
            </svg>
          </div>
          <span class="p-tag">02 · 掛波 HOIST THE SIGNAL</span>
          <h3 class="p-title">Raise the signal early</h3>
          <p>Risk assessment, emergency plans and lines-to-take prepared before the storm makes landfall — so nobody drafts in the rain.</p>
        </li>
        <li>
          <div class="scene" aria-hidden="true">
            <svg viewBox="0 0 220 96" class="scene-svg">
              <line x1="8" y1="74" x2="212" y2="74" stroke="#C9D4DE" stroke-width="1" stroke-dasharray="3 4" />
              <path class="spike" pathLength="100" d="M8,70 L56,64 L92,22" fill="none" stroke="var(--alert)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <path class="calmed" pathLength="100" d="M92,22 L122,58 L154,50 L212,46" fill="none" stroke="var(--link)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <path class="flame" d="M92,20 C88,14 90,9 92,5 C94,9 97,11 96,15 C99,13 99,11 99,9 C101,13 100,18 96,20 Z" fill="var(--alert)" />
            </svg>
          </div>
          <span class="p-tag">03 · 救火 FIGHT THE FIRE</span>
          <h3 class="p-title">Contain and steady</h3>
          <p>Press-release optimisation, alternative-opinion development, correct-information penetration and sentiment management — stage by stage of the crisis cycle.</p>
        </li>
        <li>
          <div class="scene" aria-hidden="true">
            <svg viewBox="0 0 220 96" class="scene-svg">
              <line x1="8" y1="84" x2="212" y2="84" stroke="#C9D4DE" stroke-width="1.5" />
              <rect class="bar r1" x="34" y="66" width="22" height="18" rx="2" fill="#C9D4DE" />
              <rect class="bar r2" x="72" y="54" width="22" height="30" rx="2" fill="#AFC4D6" />
              <rect class="bar r3" x="110" y="40" width="22" height="44" rx="2" fill="var(--link)" opacity=".55" />
              <rect class="bar r4" x="148" y="26" width="22" height="58" rx="2" fill="var(--link)" />
              <path class="rise" pathLength="100" d="M45,60 L83,48 L121,32 L159,20 L196,14" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
              <circle class="rise-dot" cx="196" cy="14" r="3.5" fill="var(--ink)" />
            </svg>
          </div>
          <span class="p-tag">04 · 重建 REBUILD</span>
          <h3 class="p-title">Rebuild, then fireproof</h3>
          <p>The best defence is a story worth telling: creative campaigns and community acquisition that leave the brand stronger than before the smoke.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Works · from the archive</span>
          <h2 class="h2">Stories we turned around</h2>
        </div>
        <a class="arrow-link" href="/works">All case studies →</a>
      </div>
      <div class="grid cols-3">
        {featured.map((w) => (
          <a class="work-card" href={`/works/${w.slug}`}>
            <span class="thumb"><img src={coverOf(w)} alt={`${w.client} — ${w.title}`} loading="lazy" width="640" height="400" /></span>
            <span class="meta">
              <span class="client">{w.client} · {w.services[0]}</span>
              <span class="title">{w.title}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tinted">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Clients</span>
          <h2 class="h2">Names we read for</h2>
        </div>
        <a class="arrow-link" href="/clients">All clients →</a>
      </div>
      <ul class="logo-strip" aria-label="Selected clients">
        {logoStrip.map((slug) => (
          <li><img src={`/images/clients/${slug}.webp`} alt={logoNames[slug] ?? slug} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-panel">
        <div class="cta-copy">
          <span class="eyebrow">File a brief</span>
          <h2 class="h2">The next chapter is unwritten. Let's decide who holds the pen.</h2>
          <p class="muted">
            Whether the story is turning against you or simply waiting to be told — tell us where it
            stands. The desk reads every brief within two hours.
          </p>
          <div class="hero-actions">
            <a class="btn solid" href="/contact">Brief the desk</a>
            <a class="btn" href={site.phoneHref}>Call {site.phone}</a>
          </div>
          <p class="cta-contacts">
            BRIEFS → <a href={`mailto:${site.email}`}>{site.email}</a><br />
            HOTLINE → <a href={site.phoneHref}>{site.phone}</a>
          </p>
        </div>
        <figure class="cta-photo">
          <img src="/images/studio.webp" alt="The SSHK team on the rooftop of China Paint Building, Mong Kok" loading="lazy" />
          <figcaption>THE DESK · CHINA PAINT BUILDING · MONG KOK</figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero + stream ---------- */
  .hero {
    --lineY: 60%;
    position: relative; overflow: clip;
    min-height: max(640px, calc(100svh - 64px));
    display: flex; align-items: center;
    padding: 64px 0 96px;
  }
  .stream {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 7%, #000 93%, transparent 100%);
  }
  .post {
    position: absolute; left: var(--x); top: 110%; width: 216px;
    background: var(--card); border: 1px solid var(--line); border-radius: 14px;
    padding: 11px 13px 10px; box-shadow: 0 10px 26px rgba(22, 24, 27, 0.07);
    pointer-events: auto;
    animation: drift var(--d) linear var(--dl) infinite;
  }
  .post header { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 5px; font: 500 10.5px/1 var(--font-mono); }
  .post header .u { color: var(--link); }
  .post header .t { color: var(--grey-2); }
  .post p { font: 400 12px/1.5 var(--font-sans); color: var(--ink); margin: 0; }
  .post footer { margin-top: 7px; font: 400 10px/1 var(--font-mono); color: var(--grey-2); }
  .post:hover { animation-play-state: paused; }
  .post:hover .rstamp { animation-play-state: paused; }
  .post.edge { filter: blur(1.7px); opacity: .55; }

  .rstamp {
    position: absolute; top: -10px; right: -9px;
    font: 600 9.5px/1 var(--font-mono); letter-spacing: .05em; white-space: nowrap;
    color: var(--alert); background: var(--card); border: 1px solid var(--alert);
    border-radius: 999px; padding: 4px 8px;
    opacity: 0; transform: rotate(-4deg) scale(.5);
    animation: stampIn var(--d) linear var(--dl) infinite;
  }
  @keyframes drift { from { top: 110%; } to { top: -34%; } }
  /* desk line at 60% → cards cross at (110−60)/144 ≈ 34.7% of the loop */
  @keyframes stampIn {
    0%, 34.5% { opacity: 0; transform: rotate(-4deg) scale(.5); }
    36.2% { opacity: 1; transform: rotate(-4deg) scale(1.14); }
    38% { transform: rotate(-4deg) scale(1); }
    100% { opacity: 1; transform: rotate(-4deg) scale(1); }
  }
  @keyframes stampInM {
    0%, 16.4% { opacity: 0; transform: rotate(-4deg) scale(.5); }
    18.2% { opacity: 1; transform: rotate(-4deg) scale(1.14); }
    20% { transform: rotate(-4deg) scale(1); }
    100% { opacity: 1; transform: rotate(-4deg) scale(1); }
  }

  .deskline { position: absolute; left: 0; right: 0; top: var(--lineY); z-index: 2; }
  .stream { z-index: 1; }
  .deskline .rule {
    height: 1px;
    background: linear-gradient(90deg, rgba(36, 105, 212, 0) 0, var(--link) 5%, var(--link) 95%, rgba(36, 105, 212, 0) 100%);
  }
  .dtag {
    position: absolute; right: clamp(16px, 4vw, 60px); top: -12px;
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--paper); border: 1px solid var(--link); border-radius: 999px;
    padding: 5px 12px; font: 500 10px/1 var(--font-mono); letter-spacing: .09em; color: var(--link);
  }

  /* readability veil: copy is centred, cards run clear lanes both sides;
     anything drifting behind the centre column fades under this glow */
  .veil {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: radial-gradient(ellipse 46% 72% at 50% 46%,
      var(--paper) 34%,
      color-mix(in srgb, var(--paper) 72%, transparent) 62%,
      transparent 82%);
  }
  @media (max-width: 900px) {
    .veil { background: linear-gradient(180deg,
      color-mix(in srgb, var(--paper) 92%, transparent) 0%,
      color-mix(in srgb, var(--paper) 78%, transparent) 55%,
      transparent 85%); }
  }

  .hero-panel {
    position: relative; z-index: 3;
    width: min(760px, 92vw);
    margin-inline: auto;
    text-align: center;
  }
  .hero-panel .hero-sub { margin-inline: auto; }
  .hero-actions { justify-content: center; }
  @media (max-width: 900px) { .hero-panel { width: 100%; text-align: left; } .hero-actions { justify-content: flex-start; } .hero-panel .hero-sub { margin-inline: 0; } }
  .hero-kicker {
    font: 500 11px/1.5 var(--font-mono); letter-spacing: .12em; color: var(--link);
    text-transform: uppercase; margin: 0 0 22px;
  }
  .hero-panel h1 { margin-bottom: 20px; }
  .hero-sub { font-size: 1.03rem; line-height: 1.7; color: var(--grey); max-width: 56ch; margin: 0 0 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .hero-note { margin: 24px 0 0; font: 400 10.5px/1.6 var(--font-mono); color: var(--grey-2); letter-spacing: .04em; }

  /* ---------- monitoring summary ---------- */
  .stats-wrap { padding: 0 0 clamp(64px, 8vw, 100px); }
  .stats-panel {
    background: var(--card); border: 1px solid var(--line); border-radius: 20px;
    margin-top: -54px; position: relative; z-index: 4;
    box-shadow: var(--shadow); overflow: hidden;
  }
  .stats-head {
    display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: space-between; align-items: center;
