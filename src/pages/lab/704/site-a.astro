---
import Shell from '../../../components/Prod704Shell.astro';
import jobs from '../../../data/production704.json';
const reel = jobs.filter((j) => j.thumb);
---

<Shell variant="A · 一鏡到底">
  <section class="dolly" id="dolly">
    <div class="d-track" id="d-track">
      <div class="d-stage">
        <div class="d-hud wrap">
          <span class="eyebrow">The production log · 一鏡到底</span>
          <span class="d-count num-label" id="d-count">001 / {reel.length}</span>
        </div>
        <div class="d-bar" id="d-bar" aria-hidden="true"></div>
        <div class="d-reel" id="d-reel">
          {reel.map((j, i) => (
            <figure class="d-frame">
              <a href={j.link} target="_blank" rel="noopener">
                <img src={`/images/704/${j.slug}.webp`} alt={`${j.client} — ${j.title}`} width="480" height="270" loading="lazy" />
                <figcaption>
                  <span class="n">{String(i + 1).padStart(3, '0')}</span>
                  <span><span class="c">{j.client}</span><br /><span class="t">{j.title}</span></span>
                </figcaption>
              </a>
            </figure>
          ))}
          <div class="d-end"><div><h2 class="h2">Cut.<br />That's the log.</h2><p class="num-label" style="margin-top:1rem;">{reel.length} PRODUCTIONS · SINCE 2020</p></div></div>
        </div>
      </div>
    </div>
  </section>
</Shell>

<style>
  .dolly { background: var(--card); border-block: 1px solid var(--line); }
  .d-track { height: 2800vh; }
  .d-stage { position: sticky; top: 72px; height: calc(100svh - 72px); overflow: hidden; display: flex; align-items: center; }
  .d-hud { position: absolute; top: 26px; left: 0; right: 0; display: flex; justify-content: space-between; align-items: baseline; z-index: 2; }
  .d-count { font-variant-numeric: tabular-nums; font-size: .78rem; }
  .d-bar { position: absolute; top: 0; left: 0; height: 3px; background: var(--link); width: 0; z-index: 2; }
  .d-reel { display: flex; gap: 4.5vw; padding-left: 36vw; will-change: transform; }
  .d-frame { flex: 0 0 auto; width: 42vw; margin: 0; }
  .d-frame img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 16px; border: 1px solid var(--line); box-shadow: 0 22px 60px rgba(22, 24, 27, 0.12); display: block; background: #e4e9ee; }
  .d-frame a { text-decoration: none; color: inherit; }
  .d-frame figcaption { display: flex; gap: 1rem; align-items: baseline; margin-top: 13px; }
  .d-frame .n { font: 600 11px/1 var(--font-mono); color: var(--alert); }
  .d-frame .c { font: 600 10px/1.5 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--link); }
  .d-frame .t { font-weight: 700; font-size: 1rem; letter-spacing: -.01em; }
  .d-frame a:hover .t { color: var(--link); }
  .d-end { flex: 0 0 auto; width: 56vw; display: flex; align-items: center; }
  @media (max-width: 900px) {
    .d-track { height: auto; }
    .d-stage { position: static; height: auto; overflow-x: auto; padding: 66px 0 40px; }
    .d-hud { position: static; margin-bottom: 1.2rem; }
    .d-reel { padding: 0 6vw; transform: none !important; }
    .d-frame { width: 76vw; }
    .d-bar { display: none; }
  }
</style>

<script>
  const track = document.getElementById('d-track');
  const reelEl = document.getElementById('d-reel');
  const bar = document.getElementById('d-bar');
  const count = document.getElementById('d-count');
  const total = reelEl ? reelEl.querySelectorAll('.d-frame').length : 0;
  const mq = matchMedia('(min-width: 901px)');
  const onScroll = () => {
    if (!mq.matches || !track || !reelEl) return;
    const r = track.getBoundingClientRect();
    const span = r.height - innerHeight;
    const p = Math.min(1, Math.max(0, -r.top / span));
    const max = reelEl.scrollWidth - innerWidth * 0.6;
    reelEl.style.transform = `translateX(${-p * max}px)`;
    if (bar) bar.style.width = p * 100 + '%';
    if (count) count.textContent = `${String(Math.min(total, Math.max(1, Math.round(p * total)))).padStart(3, '0')} / ${total}`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
