---
import Shell from '../../../components/Prod704Shell.astro';
import jobs from '../../../data/production704.json';
const FORMATS = ['All', 'Campaign', 'Event Highlight', 'Reels', 'Interview', 'Animation', 'Variety Show', 'Drama', 'Live Streaming'];
const strip = jobs.filter((j) => j.thumb);
const first = strip[0];
---

<Shell variant="C · 放映室">
  <section class="cinema">
    <div class="wrap">
      <div class="cin-head">
        <span class="eyebrow">The production log · 放映室</span>
        <span class="now num-label">NOW SCREENING</span>
      </div>
      <div class="screen" id="screen">
        <img id="still" src={`/images/704/${first.slug}.webp`} alt="" width="1280" height="548" />
        <div class="veil" aria-hidden="true"></div>
        <div class="slate">
          <div><div class="s-c" id="s-client">{first.client}</div><div class="s-t" id="s-title">{first.title}</div></div>
          <button class="playbtn" id="play">▶ ROLL</button>
        </div>
      </div>
      <div class="tabs" id="tabs">
        {FORMATS.map((f, i) => <button class={`tab${i === 0 ? ' on' : ''}`} data-v={f === 'All' ? '' : f}>{f.toUpperCase()}</button>)}
      </div>
      <div class="strip" id="strip">
        {strip.map((j, i) => (
          <div class="cellw" data-f={j.formats.join('|')}>
            <button class={`cell${i === 0 ? ' on' : ''}`} data-i={i} data-slug={j.slug} data-client={j.client} data-title={j.title} data-link={j.link}>
              <img src={`/images/704/${j.slug}.webp`} alt={`${j.client} — ${j.title}`} loading="lazy" width="190" height="107" />
            </button>
            <p>{j.client}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Shell>

<style>
  .cinema { background: var(--ink); padding-block: clamp(3rem, 6vw, 5rem); }
  .cin-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.6rem; }
  .now { color: var(--alert); display: inline-flex; gap: 8px; align-items: center; }
  .now::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--alert); animation: cpulse 1.6s infinite; }
  @keyframes cpulse { 50% { opacity: .3; } }
  .screen { position: relative; border-radius: 18px; overflow: hidden; border: 1px solid #2A2E34; aspect-ratio: 21 / 9; background: #000; }
  .screen img, .screen :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .veil { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.72)); }
  .slate { position: absolute; left: 26px; bottom: 22px; right: 26px; display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .s-c { font: 600 10.5px/1.6 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--alert); }
  .s-t { font-size: clamp(1.1rem, 2.2vw, 1.7rem); font-weight: 800; letter-spacing: -.015em; max-width: 28ch; color: #fff; }
  .playbtn { flex-shrink: 0; font: 600 11px/1 var(--font-mono); letter-spacing: .1em; color: #fff; background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(255, 255, 255, 0.4); backdrop-filter: blur(6px); border-radius: 999px; padding: .9em 1.6em; cursor: pointer; }
  .playbtn:hover { background: var(--alert); border-color: var(--alert); }
  .tabs { display: flex; gap: .4rem; flex-wrap: wrap; padding: 20px 0 12px; }
  .tab { font: 500 10.5px/1 var(--font-mono); letter-spacing: .08em; cursor: pointer; color: #9AA4B0; background: transparent; border: 1px solid #2A2E34; border-radius: 999px; padding: .55em 1.05em; }
  .tab.on { background: #fff; color: var(--ink); border-color: #fff; }
  .strip { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: thin; }
  .cellw { flex: 0 0 auto; }
  .cellw.hide { display: none; }
  .cell { display: block; width: 190px; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; border: 2px solid transparent; cursor: pointer; background: #22262b; padding: 0; }
  .cell img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .55; transition: opacity .25s; }
  .cell:hover img { opacity: .9; }
  .cell.on { border-color: var(--alert); }
  .cell.on img { opacity: 1; }
  .cellw p { font: 500 9px/1.4 var(--font-mono); letter-spacing: .08em; color: #9AA4B0; margin: 6px 0 0; max-width: 190px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-transform: uppercase; }
  @media (max-width: 760px) { .screen { aspect-ratio: 16 / 10; } .cell { width: 140px; } }
</style>

<script>
  const screen = document.getElementById('screen');
  const still = document.getElementById('still') as HTMLImageElement | null;
  const sc = document.getElementById('s-client');
  const st = document.getElementById('s-title');
  const strip = document.getElementById('strip');
  const tabs = document.getElementById('tabs');
  let currentLink = strip?.querySelector<HTMLElement>('.cell')?.dataset.link ?? '';
  strip?.addEventListener('click', (e) => {
    const c = (e.target as HTMLElement).closest('.cell') as HTMLElement | null;
    if (!c) return;
    screen?.querySelector('iframe')?.remove();
    if (still) still.src = `/images/704/${c.dataset.slug}.webp`;
    if (sc) sc.textContent = c.dataset.client ?? '';
    if (st) st.textContent = c.dataset.title ?? '';
    currentLink = c.dataset.link ?? '';
    strip.querySelectorAll('.cell').forEach((x) => x.classList.toggle('on', x === c));
  });
  document.getElementById('play')?.addEventListener('click', () => {
    const m = currentLink.match(/vimeo\.com\/(\d+)/);
    const yt = currentLink.match(/youtu\.be\/([\w-]+)/);
    const src = m ? `https://player.vimeo.com/video/${m[1]}?autoplay=1` : yt ? `https://www.youtube.com/embed/${yt[1]}?autoplay=1` : '';
    if (!src) { window.open(currentLink, '_blank'); return; }
    const f = document.createElement('iframe');
    f.src = src; f.allow = 'autoplay; fullscreen'; f.allowFullscreen = true;
    screen?.appendChild(f);
  });
  tabs?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.tab') as HTMLElement | null;
    if (!b) return;
    tabs.querySelectorAll('.tab').forEach((t) => t.classList.toggle('on', t === b));
    const v = b.dataset.v ?? '';
    strip?.querySelectorAll<HTMLElement>('.cellw').forEach((w) => {
      w.classList.toggle('hide', !!v && !(w.dataset.f ?? '').split('|').includes(v));
    });
  });
</script>
