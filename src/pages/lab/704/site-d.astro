---
import Shell from '../../../components/Prod704Shell.astro';
import jobs from '../../../data/production704.json';
const FORMATS = ['Campaign', 'Event Highlight', 'Reels', 'Interview', 'Animation', 'Variety Show', 'Drama', 'Live Streaming'];
const ZH: Record<string, string> = { Campaign: '品牌企劃', 'Event Highlight': '活動精華', Reels: '短片', Interview: '訪談', Animation: '動畫', 'Variety Show': '綜藝', Drama: '劇情', 'Live Streaming': '直播' };
---

<Shell variant="D · 節目表">
  <section class="guide section tinted" style="padding-bottom:1rem;">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">The production log · 節目表</span>
          <h2 class="h2">Eight channels, always on air.</h2>
        </div>
        <p class="num-label" style="text-align:right;">EACH CHANNEL SCROLLS RIGHT →<br />CLICK ANY SLOT TO SCREEN IT</p>
      </div>
    </div>
    {FORMATS.map((f, ci) => {
      const items = jobs.filter((j) => j.formats.includes(f) && j.thumb);
      return (
        <section class="channel">
          <div class="wrap ch-head">
            <span class="ch-no">CH·{String(ci + 1).padStart(2, '0')}</span>
            <span class="ch-name">{f} <span class="zh">{ZH[f]}</span></span>
            <span class="ch-count num-label">{items.length} TITLES</span>
            <span class="ch-arrow num-label">SCROLL →</span>
          </div>
          <div class="row">
            {items.map((j) => (
              <a class="slot" href={j.link} target="_blank" rel="noopener">
                <span class="fr"><img src={`/images/704/${j.slug}.webp`} alt={`${j.client} — ${j.title}`} loading="lazy" width="280" height="158" /><span class="play" aria-hidden="true">▶</span></span>
                <span class="c">{j.client}</span><span class="t">{j.title}</span>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </section>
</Shell>

<style>
  .channel { border-top: 1px solid var(--line); padding: 24px 0 26px; }
  .ch-head { display: flex; align-items: baseline; gap: 1.1rem; margin-bottom: 15px; }
  .ch-no { font: 600 11px/1 var(--font-mono); letter-spacing: .1em; color: var(--alert); }
  .ch-name { font-weight: 800; font-size: 1.2rem; letter-spacing: -.015em; }
  .ch-name .zh { color: var(--grey-2); font-weight: 600; }
  .ch-arrow { margin-left: auto; }
  .row { display: flex; gap: 12px; overflow-x: auto; padding: 2px max(calc((100vw - 1200px) / 2 + 24px), 24px) 10px; scroll-snap-type: x proximity; scrollbar-width: thin; }
  .slot { flex: 0 0 auto; width: 272px; scroll-snap-align: start; text-decoration: none; color: inherit; }
  .slot .fr { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: #e4e9ee; }
  .slot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s cubic-bezier(.2, .8, .2, 1); }
  .slot:hover img { transform: scale(1.05); }
  .slot .play { position: absolute; right: 9px; bottom: 9px; width: 26px; height: 26px; border-radius: 50%; background: rgba(22, 24, 27, 0.8); color: #fff; font-size: .55rem; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .25s; }
  .slot:hover .play { opacity: 1; }
  .slot .c { font: 600 9.5px/1.5 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--grey-2); display: block; margin-top: 9px; }
  .slot .t { font-weight: 700; font-size: .89rem; line-height: 1.4; display: block; margin-top: 2px; }
  .slot:hover .t { color: var(--link); }
</style>
