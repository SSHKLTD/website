---
import Shell from '../../../components/Prod704Shell.astro';
import jobs from '../../../data/production704.json';
const FORMATS = ['Campaign', 'Event Highlight', 'Reels', 'Interview', 'Animation', 'Variety Show', 'Drama', 'Live Streaming'];
const INDUSTRIES = ['Corporate', 'Finance', 'Institution', 'Government', 'Retail', 'NGO'];
const fCount = Object.fromEntries(FORMATS.map((f) => [f, jobs.filter((j) => j.formats.includes(f)).length]));
const iCount = Object.fromEntries(INDUSTRIES.map((i) => [i, jobs.filter((j) => j.industries.includes(i)).length]));
---

<Shell variant="F · 檔案櫃">
  <section class="archive section tinted">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">The production log · 檔案櫃</span>
          <h2 class="h2">{jobs.length} files.<br />Open any drawer.</h2>
        </div>
        <p class="num-label ar-count" id="ar-count" aria-live="polite">SHOWING {jobs.length} / {jobs.length}</p>
      </div>
      <div class="ar-layout">
        <aside class="ar-side" id="ar-side">
          <div class="fgroup">
            <p class="flabel">類別 FORMAT</p>
            <button class="fbtn on" data-dim="f" data-v="">All formats</button>
            {FORMATS.map((f) => <button class="fbtn" data-dim="f" data-v={f}>{f} <b>{fCount[f]}</b></button>)}
          </div>
          <div class="fgroup">
            <p class="flabel">行業 INDUSTRY</p>
            <button class="fbtn on" data-dim="i" data-v="">All industries</button>
            {INDUSTRIES.map((i) => <button class="fbtn" data-dim="i" data-v={i}>{i} <b>{iCount[i]}</b></button>)}
          </div>
        </aside>
        <div class="ar-rows" id="ar-rows">
          {jobs.map((j, n) => (
            <details class="file" data-f={j.formats.join('|')} data-i={j.industries.join('|')}>
              <summary>
                <span class="no">{String(n + 1).padStart(3, '0')}</span>
                {j.thumb && <span class="mini"><img src={`/images/704/${j.slug}.webp`} alt="" loading="lazy" width="96" height="54" /></span>}
                <span class="head">
                  <span class="cl">{j.client}</span>
                  <span class="ti">{j.title}</span>
                </span>
                <span class="tags">
                  {j.formats.map((f) => <span class="tag tf">{f}</span>)}
                  {j.industries.map((i) => <span class="tag ti2">{i}</span>)}
                </span>
                <span class="caret" aria-hidden="true">＋</span>
              </summary>
              <div class="body">
                {j.thumb && <a class="big" href={j.link} target="_blank" rel="noopener"><img src={`/images/704/${j.slug}.webp`} alt={`${j.client} — ${j.title}`} loading="lazy" width="1280" height="720" /><span class="roll">▶ WATCH</span></a>}
                <div class="txt">
                  {j.desc ? <p class="desc">{j.desc}</p> : <p class="desc muted">Screened on the studio's site.</p>}
                  {j.credits && <p class="credits">{j.credits}</p>}
                  <a class="arrow-link" href={j.link} target="_blank" rel="noopener">Watch the film ↗</a>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Shell>

<style>
  .ar-count { align-self: end; font-variant-numeric: tabular-nums; }
  .ar-layout { display: grid; grid-template-columns: 230px 1fr; gap: clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .ar-side { position: sticky; top: 92px; display: flex; flex-direction: column; gap: 1.5rem; }
  .flabel { font: 600 10px/1 var(--font-mono); letter-spacing: .14em; color: var(--grey-2); margin: 0 0 .6rem; }
  .fbtn { display: flex; justify-content: space-between; gap: .8rem; width: 100%; text-align: left; cursor: pointer; font: 500 12.5px/1.3 var(--font-mono); letter-spacing: .02em; color: var(--ink); background: transparent; border: none; border-left: 2px solid var(--line); padding: .45em .9em; }
  .fbtn b { font-weight: 500; color: var(--grey-2); }
  .fbtn:hover { border-left-color: var(--link); color: var(--link); }
  .fbtn.on { border-left-color: var(--link); color: var(--link); font-weight: 600; }
  .ar-rows { border-top: 1px solid var(--line); }
  .file { border-bottom: 1px solid var(--line); }
  .file.hide { display: none; }
  .file summary { display: grid; grid-template-columns: 2.6rem 96px 1fr auto 1.4rem; gap: 1.1rem; align-items: center; padding: .8rem .4rem; cursor: pointer; list-style: none; }
  .file summary::-webkit-details-marker { display: none; }
  .file summary:hover { background: var(--paper); }
  .no { font: 500 10.5px/1 var(--font-mono); color: var(--grey-2); }
  .mini { display: block; width: 96px; aspect-ratio: 16 / 9; border-radius: 7px; overflow: hidden; border: 1px solid var(--line); background: #e4e9ee; }
  .mini img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .head { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .cl { font: 600 9.5px/1.4 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--grey-2); }
  .ti { font-weight: 700; font-size: .95rem; line-height: 1.35; }
  .tags { display: flex; flex-wrap: wrap; gap: .3rem; justify-content: flex-end; max-width: 300px; }
  .tag { font: 500 8.5px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; border-radius: 999px; padding: .38em .75em; }
  .tag.tf { color: var(--link); border: 1px solid color-mix(in srgb, var(--link) 40%, transparent); }
  .tag.ti2 { color: var(--grey); border: 1px solid var(--line); background: var(--paper); }
  .caret { font: 600 13px/1 var(--font-mono); color: var(--grey-2); text-align: center; transition: transform .25s; }
  .file[open] .caret { transform: rotate(45deg); color: var(--link); }
  .file[open] summary .ti { color: var(--link); }
  .body { display: grid; grid-template-columns: minmax(280px, 420px) 1fr; gap: 1.6rem; padding: .4rem .4rem 1.5rem 4.1rem; }
  .big { position: relative; display: block; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); }
  .big img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  .roll { position: absolute; right: 10px; bottom: 10px; font: 600 9.5px/1 var(--font-mono); letter-spacing: .08em; color: #fff; background: rgba(22, 24, 27, 0.82); border-radius: 999px; padding: 6px 11px; }
  .big:hover .roll { background: var(--link); }
  .txt { max-width: 56ch; }
  .desc { font-size: .92rem; line-height: 1.7; color: var(--grey); margin: 0 0 .9rem; white-space: pre-line; }
  .credits { font: 400 10.5px/1.7 var(--font-mono); color: var(--grey-2); margin: 0 0 .9rem; white-space: pre-line; }
  .txt .arrow-link { font-size: .88rem; }
  @media (max-width: 980px) {
    .ar-layout { grid-template-columns: 1fr; }
    .ar-side { position: static; flex-direction: row; flex-wrap: wrap; gap: 1.5rem 2.5rem; }
    .file summary { grid-template-columns: 2.2rem 72px 1fr 1.2rem; }
    .tags { display: none; }
    .mini { width: 72px; }
    .body { grid-template-columns: 1fr; padding-left: .4rem; }
  }
</style>

<script>
  const state = { f: '', i: '' };
  const rows = document.getElementById('ar-rows');
  const count = document.getElementById('ar-count');
  const total = rows ? rows.children.length : 0;
  document.getElementById('ar-side')?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.fbtn') as HTMLElement | null;
    if (!b || !rows) return;
    const dim = b.dataset.dim as 'f' | 'i';
    state[dim] = b.dataset.v ?? '';
    document.querySelectorAll(`.fbtn[data-dim="${dim}"]`).forEach((x) => x.classList.toggle('on', x === b));
    let shown = 0;
    for (const el of rows.children) {
      const d = el as HTMLElement;
      const okF = !state.f || (d.dataset.f ?? '').split('|').includes(state.f);
      const okI = !state.i || (d.dataset.i ?? '').split('|').includes(state.i);
      d.classList.toggle('hide', !(okF && okI));
      if (okF && okI) shown++;
    }
    if (count) count.textContent = `SHOWING ${shown} / ${total}`;
  });
</script>
