---
import Shell from '../../../components/Prod704Shell.astro';
import jobs from '../../../data/production704.json';
const FORMATS = ['Campaign', 'Event Highlight', 'Reels', 'Interview', 'Animation', 'Variety Show', 'Drama', 'Live Streaming'];
const INDUSTRIES = ['Corporate', 'Finance', 'Institution', 'Government', 'Retail', 'NGO'];
const fCount = Object.fromEntries(FORMATS.map((f) => [f, jobs.filter((j) => j.formats.includes(f)).length]));
const iCount = Object.fromEntries(INDUSTRIES.map((i) => [i, jobs.filter((j) => j.industries.includes(i)).length]));
---

<Shell variant="G · 場刊">
  <section class="notes section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">The production log · 場刊</span>
          <h2 class="h2">Programme notes,<br />all {jobs.length} screenings.</h2>
        </div>
        <p class="num-label pn-count" id="pn-count" aria-live="polite">SHOWING {jobs.length} / {jobs.length}</p>
      </div>

      <div class="pn-filters" id="pn-filters">
        <div class="f-row" role="group" aria-label="Filter by format">
          <span class="f-label">類別 FORMAT</span>
          <button class="f-chip on" data-dim="f" data-v="">All</button>
          {FORMATS.map((f) => <button class="f-chip" data-dim="f" data-v={f}>{f} <b>{fCount[f]}</b></button>)}
        </div>
        <div class="f-row" role="group" aria-label="Filter by industry">
          <span class="f-label">行業 INDUSTRY</span>
          <button class="f-chip on" data-dim="i" data-v="">All</button>
          {INDUSTRIES.map((i) => <button class="f-chip" data-dim="i" data-v={i}>{i} <b>{iCount[i]}</b></button>)}
        </div>
      </div>

      <div class="entries" id="entries">
        {jobs.map((j, n) => (
          <article class="entry" data-f={j.formats.join('|')} data-i={j.industries.join('|')}>
            <a class="e-thumb" href={j.link} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
              {j.thumb ? (
                <img src={`/images/704/${j.slug}.webp`} alt="" loading="lazy" width="1280" height="720" />
              ) : (
                <span class="noimg">704</span>
              )}
              <span class="roll">▶</span>
            </a>
            <div class="e-body">
              <p class="e-top"><span class="no">{String(n + 1).padStart(3, '0')}</span><span class="cl">{j.client}</span></p>
              <h3 class="e-title"><a href={j.link} target="_blank" rel="noopener">{j.title}</a></h3>
              {j.desc && <p class="e-desc">{j.desc}</p>}
              <p class="e-tags">
                {j.formats.map((f) => <span class="tag tf">{f}</span>)}
                {j.industries.map((i) => <span class="tag ti2">{i}</span>)}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Shell>

<style>
  .pn-count { align-self: end; font-variant-numeric: tabular-nums; }
  .pn-filters { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 2.4rem; }
  .f-row { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; }
  .f-label { font: 500 .62rem/1 var(--font-mono); letter-spacing: .12em; color: var(--grey-2); min-width: 7rem; }
  .f-chip { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .05em; cursor: pointer; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: .5em 1em; transition: border-color var(--snap), background var(--snap), color var(--snap); }
  .f-chip b { font-weight: 500; color: var(--grey-2); margin-left: .15em; }
  .f-chip:hover { border-color: var(--link); }
  .f-chip.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .f-chip.on b { color: #9fb3c8; }

  .entries { display: flex; flex-direction: column; }
  .entry { display: grid; grid-template-columns: minmax(300px, 460px) 1fr; gap: clamp(1.4rem, 3vw, 2.6rem); padding: clamp(1.6rem, 3vw, 2.4rem) 0; border-top: 1px solid var(--line); }
  .entry.hide { display: none; }
  .e-thumb { position: relative; display: block; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: #e4e9ee; align-self: start; }
  .e-thumb img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; transition: transform .45s cubic-bezier(.2, .8, .2, 1); }
  .entry:hover .e-thumb img { transform: scale(1.03); }
  .noimg { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; font: 700 2rem var(--font-mono); color: var(--grey-2); }
  .roll { position: absolute; right: 12px; bottom: 12px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; font-size: .62rem; color: #fff; background: rgba(22, 24, 27, 0.8); border-radius: 999px; opacity: 0; transform: translateY(4px); transition: opacity .25s, transform .25s; }
  .entry:hover .roll { opacity: 1; transform: none; }
  .e-top { display: flex; gap: 1rem; align-items: baseline; margin: 0 0 .5rem; }
  .no { font: 600 10.5px/1 var(--font-mono); color: var(--alert); }
  .cl { font: 600 10px/1.5 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; color: var(--grey-2); }
  .e-title { font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 800; letter-spacing: -.015em; line-height: 1.3; margin: 0 0 .7rem; }
  .e-title a { color: inherit; text-decoration: none; }
  .e-title a:hover { color: var(--link); }
  .e-desc { font-size: .93rem; line-height: 1.75; color: var(--grey); max-width: 62ch; margin: 0 0 1rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .e-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; }
  .tag { font: 500 8.5px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; border-radius: 999px; padding: .4em .8em; }
  .tag.tf { color: var(--link); border: 1px solid color-mix(in srgb, var(--link) 40%, transparent); }
  .tag.ti2 { color: var(--grey); border: 1px solid var(--line); background: var(--card); }
  @media (max-width: 820px) {
    .entry { grid-template-columns: 1fr; gap: 1rem; }
    .f-label { min-width: 100%; }
  }
</style>

<script>
  const state = { f: '', i: '' };
  const entries = document.getElementById('entries');
  const count = document.getElementById('pn-count');
  const total = entries ? entries.children.length : 0;
  document.getElementById('pn-filters')?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.f-chip') as HTMLElement | null;
    if (!b || !entries) return;
    const dim = b.dataset.dim as 'f' | 'i';
    state[dim] = b.dataset.v ?? '';
    document.querySelectorAll(`.f-chip[data-dim="${dim}"]`).forEach((x) => x.classList.toggle('on', x === b));
    let shown = 0;
    for (const el of entries.children) {
      const d = el as HTMLElement;
      const okF = !state.f || (d.dataset.f ?? '').split('|').includes(state.f);
      const okI = !state.i || (d.dataset.i ?? '').split('|').includes(state.i);
      d.classList.toggle('hide', !(okF && okI));
      if (okF && okI) shown++;
    }
    if (count) count.textContent = `SHOWING ${shown} / ${total}`;
  });
</script>
