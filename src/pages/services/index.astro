---
import Base from '../../layouts/Base.astro';

const services = [
  {
    n: '01',
    k: 'LISTEN',
    title: 'Social Listening',
    href: '/services/social-listening',
    desc: 'Every crisis is a whisper before it is a headline. Our desk reads Hong Kong the way an editor reads the wires — around the clock, across every platform, in both languages the city argues in.',
    points: ['24/7 monitoring & alert', 'Daily / weekly / monthly reporting', 'Sentiment & share-of-voice analysis', 'Ad-hoc crisis deep-dives'],
  },
  {
    n: '02',
    k: 'MANAGE',
    title: 'Issue & Crisis Management',
    href: '/services/issue-management',
    desc: 'When the story turns, the worst place to draft your reply is the middle of the storm. We write the statement, brief the room, and steady the narrative while it can still be steadied.',
    points: ['Five-dimension risk assessment', 'High/low risk grading', 'Response strategy & advisory', 'Post-incident reporting'],
  },
  {
    n: '03',
    k: 'CREATE',
    title: 'Campaign & Production',
    href: '/services/campaign-production',
    desc: 'The best defence is a story worth telling. From key visual to final cut, our studio makes work people share because they want to — with strategy, design, film and always-on publishing under one roof.',
    points: ['Concept creation & project management', 'Social media retainers', 'Photography & video production', 'Ad placement & optimisation', 'KOL & media amplification'],
  },
];
---

<Base
  title="Services | SSHK"
  description="Social listening, issue & crisis management, campaign & production — the three service pillars of Social Strategy Hong Kong."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1 class="display">Three chapters.<br /><span class="hl">One discipline.</span></h1>
      <p class="lede" style="margin-top:1.5rem;">
        Listening, managing, creating — in that order, because that is the order in which stories are
        won. From the first whisper of an issue to the story everyone remembers.
      </p>
    </div>
  </section>

  {services.map((s, i) => (
    <section class={`section ${i % 2 === 0 ? 'tinted' : ''}`}>
      <div class="wrap grid cols-2">
        <div>
          <p class="num-label" style="font-size:.9rem;">{s.n} · {s.k}</p>
          <h2 class="h2" style="margin-top:.8rem;">{s.title}</h2>
          <p class="body-max" style="margin-top:1.2rem;">{s.desc}</p>
          <p style="margin-top:1.8rem;"><a class="btn" href={s.href}>Explore {s.title} →</a></p>
        </div>
        <ul class="check-list" style="align-self:center;">
          {s.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>
  ))}
</Base>
